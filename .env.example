# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Environment
NODE_ENV=development

# PWA
NEXT_PUBLIC_APP_NAME=KAD-SAMIS
NEXT_PUBLIC_APP_DESCRIPTION=Kaduna State Asset Management Information System

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@example.gov.ng

# Error tracking + performance monitoring (https://sentry.io — free tier).
# Leave unset and Sentry stays a documented no-op everywhere it's
# referenced (see sentry.*.config.ts, src/lib/logger.ts). A DSN is a
# write-only ingest endpoint, not a secret, so it's fine to expose to the
# client — SENTRY_AUTH_TOKEN below is the one that must stay server-only.
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug
# Only needed in CI/build to upload source maps — never required at runtime.
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Rate limiting (https://upstash.com — free tier, serverless-friendly Redis).
# Leave unset and src/lib/rate-limit.ts falls back to an in-memory limiter
# (fine for a single-instance/dev server, not correct across multiple
# serverless instances — see that file's comments).
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Passkey / biometric sign-in (WebAuthn — see src/lib/webauthn.ts). Leave
# unset in dev and on a single well-behaved domain: the RP ID and origin are
# derived per-request from the `host`/`x-forwarded-proto` headers. Only set
# these if the app sits behind a proxy that doesn't forward those cleanly,
# or to pin them explicitly in production.
# WEBAUTHN_RP_ID=kadsamis.example.gov.ng
# WEBAUTHN_RP_NAME=Kadsamis
# WEBAUTHN_ORIGIN=https://kadsamis.example.gov.ng
